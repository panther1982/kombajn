# ------- baza -------
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://kombajn:TU_TO_SAMO_HASLO@postgres:5432/kombajn

# ------- szyfrowanie kluczy sklepow -------
# python -c "from app.crypto import generate_key; print(generate_key())"
FERNET_KEY=

# ------- bramka AI (TWOJ klucz; pusty = tryb testowy bez wywolan) -------
ANTHROPIC_API_KEY=

# ------- worker -------
WORKER_ID=worker-1
LOCK_TIMEOUT_SECONDS=600

# ------- panel webowy -------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=1
WEB_PORT=8080

# Zdjecia (gpt-image-2); pusty = tryb podgladu (lokalny retusz bez AI)
OPENAI_API_KEY=
# Skladowanie zdjec
DATA_DIR=/data
# Bezpiecznik: 0 = opisy tylko podgladem (nic nie idzie do sklepu), 1 = zapis wlaczony
WRITE_ENABLED=0
# Odstep miedzy wywolaniami obrazowymi (limit Tier 2 ~20/min, wspolny dla klucza)
IMAGE_MIN_INTERVAL_SECONDS=4
