# ------- baza -------
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://kombajn:TU_TO_SAMO_HASLO@postgres:5432/kombajn

# ------- szyfrowanie kluczy sklepow -------
# python -c "from app.crypto import generate_key; print(generate_key())"
FERNET_KEY=

# ------- bramka AI (TWOJ klucz; pusty = tryb testowy bez wywolan) -------
ANTHROPIC_API_KEY=

# ------- worker -------
WORKER_ID=worker-1
LOCK_TIMEOUT_SECONDS=600

# ------- panel webowy -------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=1
WEB_PORT=8080

# Zdjecia (gpt-image-2); pusty = tryb podgladu (lokalny retusz bez AI)
OPENAI_API_KEY=
# Skladowanie zdjec
DATA_DIR=/data
# Bezpiecznik: 0 = opisy tylko podgladem (nic nie idzie do sklepu), 1 = zapis wlaczony
WRITE_ENABLED=0
# Odstep miedzy wywolaniami obrazowymi (limit Tier 2 ~20/min, wspolny dla klucza)
IMAGE_MIN_INTERVAL_SECONDS=4

# ------- poczta (zaproszenia dla klientow) -------
SMTP_HOST=poczta.home.pl
SMTP_PORT=587
SMTP_USER=kontakt@agent007.com.pl
SMTP_PASSWORD=
SMTP_FROM=kontakt@agent007.com.pl
SMTP_FROM_NAME=Kombajn
# adres publiczny panelu - uzywany w linkach w mailach
PUBLIC_BASE_URL=https://merebilo.agent007.com.pl
TRIAL_CREDITS=10

# ------- stawki do wyliczania kosztu AI (sprawdz aktualne u dostawcow) -------
PRICE_CLAUDE_IN_USD_MTOK=3.0
PRICE_CLAUDE_OUT_USD_MTOK=15.0
PRICE_IMAGE_USD=0.048
USD_PLN=3.65
PRICE_IMAGE_IN_USD_MTOK=8.0
PRICE_IMAGE_OUT_USD_MTOK=30.0
PRICE_IMAGE_TEXT_USD_MTOK=5.0

# ------- ograniczenia kosztu obrobki zdjec -------
# maksymalny bok zdjecia wysylanego do modelu (wiecej = drozej, bez zysku)
MAX_INPUT_IMAGE_SIDE=1536
# maksymalny rozmiar wgrywanego pliku w MB
MAX_UPLOAD_MB=12
